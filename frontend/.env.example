# Copy this file to frontend/.env (cp .env.example .env). The .env file is not committed.

# Same value as DEMO_PASSWORD in backend/.env. The tests need it, so it can't be empty when you run them.
# Anything starting with VITE_ ends up in the public JavaScript of a build, so deployed builds leave it empty.
VITE_DEMO_PASSWORD=

# Dev server port, and where to send /api requests (the backend from `npm run dev` in backend/)
DEV_PORT=5005
API_URL=http://localhost:8787
