# Copy this file to backend/.env (cp .env.example .env). The .env file is not committed.

# Password of the demo accounts. It is not stored in the repo, so ask for it.
# The committed seed (db/seed/seed.sql) was generated with this value. If you use a different one,
# run `npm run db:seed:generate` and commit the new seed.
DEMO_PASSWORD=

# Hash cost used when building the seed
PBKDF2_ITERATIONS=20000

# How long a session lasts, in seconds (28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Shown by /api/health. In production CI sets it to the git SHA.
RELEASE=local
